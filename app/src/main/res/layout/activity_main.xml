<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="24dp"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <TextView android:text="Bravo Helper" android:textSize="24sp"
        android:textStyle="bold" android:layout_marginBottom="24dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />

    <EditText android:id="@+id/phoneInput"
        android:hint="رقم الهاتف (بدون 249)" android:inputType="phone"
        android:layout_width="match_parent" android:layout_height="wrap_content" />

    <EditText android:id="@+id/referralInput"
        android:hint="كود الدعوة" android:text="F2AKUX"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent" android:layout_height="wrap_content" />

    <Button android:id="@+id/startBtn"
        android:text="ابدأ إنشاء الحساب" android:layout_marginTop="24dp"
        android:layout_width="match_parent" android:layout_height="wrap_content" />

    <Button android:id="@+id/accBtn"
        android:text="تفعيل خدمة الأتمتة (اضغط أول مرة)" android:layout_marginTop="12dp"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>
